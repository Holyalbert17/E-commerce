{
  "ConnectionStrings": {
    "EcomDb": "Data Source=App_Data/ecom.db",
    "Erp": ""
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ECommerce": {
    "IntegrationMode": "Standalone",
    "DefaultTenantSlug": "demo"
  },
  "Erp": {
    "Enabled": false,
    "AllowWriteBack": false,
    "AutoWriteBack": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
